# Runtime PostgreSQL URL. Use the Supabase transaction pooler in production (port 6543, with pgbouncer=true).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&connection_limit=1"

# Direct PostgreSQL URL for Prisma migrations (Supabase direct connection or session pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Frontend's exact deployed origin, with no path; local Angular origin is allowed outside production.
FRONTEND_URL="https://your-angular-domain.example"

# Set to production on Vercel; PORT is supplied by the local server when running locally.
NODE_ENV="production"

# Required authentication secrets: use independent random values of at least 32 characters.
SESSION_SECRET="replace-with-a-random-value-at-least-32-characters"
OTP_SECRET="replace-with-a-different-random-value-at-least-32-characters"

# Required only for email password reset.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="CampusX <no-reply@example.com>"

# Required only when Google sign-in is enabled; callback URL must match Google OAuth configuration.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://your-backend-domain.example/api/auth/google/callback"

